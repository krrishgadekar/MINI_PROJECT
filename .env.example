# ==============================================================================
# CreditFlow — Root Environment Configuration (.env.example)
#
# Quickstart with Docker Compose:
#   1. Copy this file: cp .env.example .env
#   2. Start services: docker compose up -d
#   3. Open app in browser: http://localhost:3000
# ==============================================================================

# Server Runtime
PORT=4000
NODE_ENV=production
AUTO_SEED=true

# Database (use mongodb://localhost:27017/creditflow for bare-metal run)
MONGO_URI=mongodb://mongo:27017/creditflow

# Python Engine (use http://localhost:8000 for bare-metal run)
PYTHON_ENGINE_URL=http://engine:8000

# Authentication (JWT)
JWT_ACCESS_SECRET=creditflow_access_secret_development_demo_2026
JWT_REFRESH_SECRET=creditflow_refresh_secret_development_demo_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS & WebSocket Allowed Origins (comma-separated)
CLIENT_ORIGINS=http://localhost:3000,http://localhost:80,http://127.0.0.1:3000,http://127.0.0.1:80

# Background Schedulers (Overdue checker, notifications digest)
CRON_ENABLED=true

# Tenant Settings
INVITE_CODE_LENGTH=8

# Client Application (Vite build args & runtime)
VITE_API_BASE_URL=http://localhost:4000/api
VITE_WS_URL=http://localhost:4000
VITE_MOCK_DOMAINS=
