# Environment variables for CreditFlow backend
# Copy this file to .env and fill in your values

PORT=4000
MONGO_URI=mongodb://localhost:27017/creditflow
JWT_ACCESS_SECRET=creditflow_access_secret_dev
JWT_REFRESH_SECRET=creditflow_refresh_secret_dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PYTHON_ENGINE_URL=http://localhost:8000

# Client CORS & Origins (comma-separated)
CLIENT_ORIGINS=http://localhost:3000,http://localhost:4000

# Background schedulers
CRON_ENABLED=true

# Tenant invite code settings
INVITE_CODE_LENGTH=8
