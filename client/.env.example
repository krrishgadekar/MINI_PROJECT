# ==============================================================================
# CreditFlow Client Environment Configuration (.env.example)
# ==============================================================================

# Backend API base URL
VITE_API_BASE_URL=http://localhost:4000/api

# Realtime WebSocket URL
VITE_WS_URL=http://localhost:4000

# Mock delegation configuration:
#  - 'all' or '*' => All domains use client-side in-memory mock adapters
#  - 'none' => All domains call the real Node/Express backend
#  - Comma-separated list => specific domains use mock adapters while others hit real backend
#
# Phase 3 Default: 'risk,notifications' along with groups, debts, audit, settlement, graph run against real backend.
# Set to empty or 'none' for full live backend integration.
VITE_MOCK_DOMAINS=
